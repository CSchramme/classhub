# Copy this file to .env and fill in real values for local development.
# Never commit .env or any file containing real secrets.

# --- Database (PostgreSQL) ---
# Local dev default matches docker-compose.yml.
DATABASE_URL=postgresql://classhub:classhub@localhost:5432/classhub

# --- Auth ---
# Server-side secret used for signing/HMAC purposes. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# --- AI (Anthropic) ---
# Never exposed to the client.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Internal ClassHub usage budget (EUR/month), not the actual Anthropic account balance.
AI_MONTHLY_BUDGET_EUR=5

# --- Object Storage (S3-compatible) ---
# Local dev default matches the MinIO service in docker-compose.yml.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=classhub
STORAGE_SECRET_KEY=classhub-secret
STORAGE_BUCKET=classhub
# Required for MinIO / most non-AWS S3-compatible providers.
STORAGE_FORCE_PATH_STYLE=true

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Notification reminders (cron) ---
# Shared secret for app/api/cron/notifications. There's no in-app scheduler
# — point your own crontab (or your host's scheduler) at that endpoint with
# an `Authorization: Bearer <this value>` header, e.g. hourly. Generate with:
#   openssl rand -base64 32
CRON_SECRET=
